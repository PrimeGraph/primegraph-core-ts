{
  // The co-located tests, built to their own output directory so the published
  // dist/ holds the library alone. Everything else — the CommonJS module format
  // included — is inherited, so the tests run against the code as it ships.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "outDir": "dist-test",
    // The suites import node:test and node:assert.
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["dist", "dist-test", "node_modules"]
}
